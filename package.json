{
  "name": "ab-jk-uash",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "AB-JK-UASH — gestão do Lava Rápido JK com React Spectrum 2",
  "scripts": {
    "start": "node scripts/start.mjs",
    "server": "node --watch server/index.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "sdk:build": "node scripts/sdk-build.mjs",
    "api:generate": "node scripts/sdk-contract.mjs",
    "bootstrap:admin": "node scripts/jk-bootstrap-admin.mjs",
    "test:infra": "node --test infra/tests/*.test.mjs",
    "release:check": "node scripts/jk-release-check.mjs check"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@react-spectrum/s2": "1.8.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "lightningcss": "1.33.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "typescript": "7.0.2",
    "unplugin-parcel-macros": "0.2.0",
    "vite": "8.3.4"
  }
}
