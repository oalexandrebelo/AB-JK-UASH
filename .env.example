# SQLite local: no environment variable is necessary. Never prefix secrets
# with VITE_; Vite includes those variables in public browser assets.

# Optional PostgreSQL. Use a dedicated, restricted role. No real credentials.
# Supabase shared pooler uses ROLE.PROJECT_REF as its login name.
# DATABASE_URL=postgresql://ab_uash_app.YOUR_PROJECT_REF:REPLACE_SECRET@YOUR_POOLER:6543/postgres
DATABASE_SCHEMA=ab_uash
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Vercel native Node body stream, required in preview and production.
NODEJS_HELPERS=0
# Vercel bootstrap token; 32–256 base64url characters. Generate privately:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# AB_UASH_SETUP_TOKEN=REPLACE_WITH_RANDOM_INSTALLATION_TOKEN

# Explicit custom-domain origin. Vercel adds its own system URL aliases.
# PUBLIC_ORIGIN=https://your-domain.example

# Optional standalone server (server/index.mjs / scripts/start.mjs):
# SETUP_TOKEN=REPLACE_WITH_RANDOM_INSTALLATION_TOKEN
# COOKIE_SECURE=true
# DATABASE_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# External provider setup is opt-in; full contract in docs/integrations/FISCAL.md.
AB_UASH_FISCAL_ENABLED=false
AB_UASH_FISCAL_PROVIDER=focusnfe
AB_UASH_FISCAL_ENVIRONMENT=sandbox
