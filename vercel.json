{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "integrations/fiscal/schema.sql",
      "excludeFiles": "{runtime/**,data/**,backups/**,tests/**,docs/**,sdk/**,public/**,dist/**}"
    }
  },
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index"}],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
      {"key": "Cross-Origin-Resource-Policy", "value": "same-origin"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}
    ]},
    {"source": "/assets/:path*", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/ocr/:path*", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, must-revalidate"}]},
    {"source": "/api/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
